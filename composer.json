{
  "name": "omosde/contao-om-fastaccess",
  "type": "contao-bundle",
  "description": "Contao 5.3+ module to protect single sites by token",
  "license": "LGPL-3.0+",
  "authors": [
    {
      "name": "Renè Fehrmann",
      "homepage": "http://www.omos.de"
    }
  ],
  "require": {
    "php": "^8.1",
    "contao/core-bundle": "^5.3"
  },
  "require-dev": {
    "contao/manager-plugin": "^2.3.1",
    "doctrine/doctrine-cache-bundle": "^1.3"
  },
  "autoload": {
    "psr-4": {
      "OMOSde\\ContaoOmFastaccessBundle\\": "src/"
    },
    "classmap": [
      "contao/"
    ],
    "exclude-from-classmap": [
      "contao/config/",
      "contao/dca/"
    ]
  },
  "extra": {
    "contao-manager-plugin": "OMOSde\\ContaoOmFastaccessBundle\\ContaoManager\\Plugin"
  }
}
